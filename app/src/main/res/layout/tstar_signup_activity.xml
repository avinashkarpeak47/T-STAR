<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:id="@+id/entry_page_ll_id1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/finalist_signup_bg">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create\naccount"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginTop="70dp"
            android:layout_marginLeft="31dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="28dp"
            android:layout_marginTop="150dp">

            <!-- NAME SECTION (FIRST + LAST SIDE BY SIDE) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- First Name -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="First Name"
                        android:textColor="@color/black"
                        android:textSize="16sp" />

                    <EditText
                        android:id="@+id/et_signup_firstname"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/s_edittext_border"
                        android:paddingStart="14dp"
                        android:hint="Enter first name"
                        android:textColor="@color/black"
                        android:textColorHint="#8A8A8A"
                        android:layout_marginTop="6dp"
                        android:inputType="textPersonName" />
                </LinearLayout>

                <!-- Last Name -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Last Name"
                        android:textColor="@color/black"
                        android:textSize="16sp" />

                    <EditText
                        android:id="@+id/et_signup_lastname"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/s_edittext_border"
                        android:paddingStart="14dp"
                        android:hint="Enter last name"
                        android:textColor="@color/black"
                        android:textColorHint="#8A8A8A"
                        android:layout_marginTop="6dp"
                        android:inputType="textPersonName" />
                </LinearLayout>

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginTop="11dp">

                <!-- ROLE SELECTION -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Select Role :"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:layout_marginTop="14dp"
                    android:layout_weight="0.7"/>

                <RadioGroup
                    android:id="@+id/rg_signup_select_role"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp"
                    android:layout_weight="1.3">

                    <RadioButton
                        android:id="@+id/rb_signup_studentrole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Student"
                        android:textColor="@color/black" />

                    <RadioButton
                        android:id="@+id/rb_signup_teacherrole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Teacher"
                        android:layout_marginStart="40dp"
                        android:textColor="@color/black" />
                </RadioGroup>

            </LinearLayout>

            <!-- Mobile Field-->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Mobile no"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/et_signup_mobile"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/s_edittext_border"
                android:paddingStart="14dp"
                android:hint="Enter your mobile number"
                android:textColor="@color/black"
                android:textColorHint="#8A8A8A"
                android:layout_marginTop="6dp"
                android:inputType="number"
                android:maxLength="10"/>

            <!-- Email Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Email"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:layout_marginTop="10dp" />

            <EditText
                android:id="@+id/et_signup_email"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/s_edittext_border"
                android:paddingStart="14dp"
                android:hint="Enter your email"
                android:textColor="@color/black"
                android:textColorHint="#8A8A8A"
                android:layout_marginTop="6dp"
                android:inputType="textEmailAddress" />

            <!-- Password Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Password"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/et_signup_password"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/s_edittext_border"
                android:paddingStart="14dp"
                android:hint="Enter your password"
                android:inputType="textPassword"
                android:textColor="@color/black"
                android:textColorHint="#8A8A8A"
                android:layout_marginTop="6dp" />




            <!-- Register Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_signup"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Register"
                android:textAllCaps="false"
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:background="@drawable/s_btn_bg_shape"
                android:layout_marginTop="18dp" />

            <!-- Already Registered -->
            <TextView
                android:id="@+id/tv_login_on_signup_page"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? Login!"
                android:textSize="13sp"
                android:textColor="@color/black"
                android:layout_gravity="center"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
