<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    card_view:cardCornerRadius="13dp"
    android:background="@color/white"
    card_view:cardElevation="8dp"
    android:layout_marginBottom="12dp"
    app:ignore="NamespaceTypo">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:background="@drawable/s_classess_card_bg">

        <!-- TEXT CONTENT AREA (LEFT SIDE) -->
        <LinearLayout
            android:id="@+id/leftPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvClassName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Physics Batch 2025"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubjectName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Subject: Physics"
                android:textSize="14sp"
                android:textColor="@color/dark_greay" />

        </LinearLayout>

        <!-- ARROW ICON (RIGHT SIDE) -->
        <ImageView
            android:id="@+id/imgArrow"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/s_right_arrow"
            app:tint="@color/black"
            android:padding="4dp" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>
