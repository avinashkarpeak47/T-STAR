<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- 🔥 LEFT COLOR STRIP (same as top) -->
        <View
            android:id="@+id/colorStrip"
            android:layout_width="6dp"
            android:layout_height="0dp"
            android:background="@color/maroon_variant"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- ⭐ CLASS NAME -->
        <TextView
            android:id="@+id/tvClassName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Class 5 A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/colorStrip"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- 🆔 CLASS ID -->
        <TextView
            android:id="@+id/tvClassId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Class ID"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvClassName"
            app:layout_constraintStart_toEndOf="@id/colorStrip"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- 👥 TOTAL STUDENTS -->
        <TextView
            android:id="@+id/tvtotal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Total Students"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvClassId"
            app:layout_constraintStart_toEndOf="@id/colorStrip"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
