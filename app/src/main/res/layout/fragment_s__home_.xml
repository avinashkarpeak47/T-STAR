<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fitsSystemWindows="true">

    <!-- Top maroon header -->
    <View
        android:id="@+id/header_bg"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:background="@drawable/header_gradient"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Greeting + profile -->
    <TextView
        android:id="@+id/tv_greeting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Good morning "
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:layout_marginTop="20sp"
        app:layout_constraintTop_toTopOf="@id/header_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/iv_profile"
        app:layout_constraintHorizontal_bias="0.0"/>

    <ImageView
        android:id="@+id/iv_profile"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:scaleType="centerCrop"
        android:src="@drawable/baseline_person_outline_24"
        android:layout_marginEnd="16dp"
        android:background="@drawable/profile_circle"
        android:padding="2dp"
        android:layout_marginTop="20sp"
        app:layout_constraintTop_toTopOf="@id/header_bg"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Rounded white container that overlaps header -->
    <androidx.cardview.widget.CardView
        android:id="@+id/content_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="28dp"
        app:cardUseCompatPadding="true"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/bg_light"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="-40dp"
        app:layout_constraintTop_toBottomOf="@id/header_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Promo Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/maroon_variant"
                    android:layout_marginBottom="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="14dp">






                    </RelativeLayout>

                </androidx.cardview.widget.CardView>

                <!-- Search bar -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="@android:color/white">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:id="@+id/ic_search"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/s_search"
                            android:tint="@color/maroon"
                            android:forceHasOverlappingRendering="true" :tint="#999999"
                            android:layout_centerVertical="true"/>

                        <EditText
                            android:id="@+id/et_search"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_toEndOf="@id/ic_search"
                            android:layout_marginStart="12dp"
                            android:gravity="center_vertical"
                            android:hint="Search For..."
                            android:background="@android:color/transparent"
                            android:textColor="#333"
                            android:textSize="14sp"
                            android:paddingEnd="8dp"/>
                    </RelativeLayout>

                </androidx.cardview.widget.CardView>

                <!-- Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="What do you need?"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#222"
                    android:layout_marginBottom="12dp"/>

                <!-- Grid of icons (4 columns) -->
                <GridLayout
                    android:id="@+id/icon_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4"
                    android:rowCount="2"
                    android:useDefaultMargins="true">

                    <!-- Single icon item - duplicate / edit labels & drawables as needed -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="6dp">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/icon_circle_bg"
                            android:padding="10dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/s_attendance"
                                android:tint="@color/maroon"
                                android:adjustViewBounds="true"
                                android:scaleType="centerInside"/>
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Attendance"
                            android:textSize="11dp"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>

                    <!-- Repeat 7 more items with different ids/drawables/labels -->
                    <!-- 2 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="6dp">
                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/icon_circle_bg"
                            android:padding="10dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/s_translator"
                                android:tint="@color/maroon"
                                android:adjustViewBounds="true"
                                android:scaleType="centerInside"/>

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Translator"
                            android:textSize="11sp"
                            android:layout_marginTop="8dp"/>

                    </LinearLayout>

                    <!-- 3 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="6dp">
                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/icon_circle_bg"
                            android:padding="10dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/s_notification"
                                android:tint="@color/maroon"
                                android:adjustViewBounds="true"
                                android:scaleType="centerInside"/>

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reminder"
                            android:textSize="11sp"
                            android:layout_marginTop="8dp"/>

                    </LinearLayout>

                    <!-- 4 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="6dp">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/icon_circle_bg"
                            android:padding="10dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/s_notes"
                                android:tint="@color/maroon"
                                android:adjustViewBounds="true"
                                android:scaleType="centerInside"/>

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Notes"
                            android:textSize="11sp"
                            android:layout_marginTop="8dp"/>

                    </LinearLayout>

                    <!-- second row -->
                    <!-- 5 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="6dp">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/icon_circle_bg"
                            android:padding="10dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/s_ai"
                                android:tint="@color/maroon"
                                android:adjustViewBounds="true"
                                android:scaleType="centerInside"/>

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ai"
                            android:textSize="12sp"
                            android:layout_marginTop="8dp"/>

                    </LinearLayout>

                    <!-- 6 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="6dp">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/icon_circle_bg"
                            android:padding="10dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/s_quiz"
                                android:tint="@color/maroon"
                                android:adjustViewBounds="true"
                                android:scaleType="centerInside"/>

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quiz"
                            android:textSize="11sp"
                            android:layout_marginTop="8dp"/>

                    </LinearLayout>

                    <!-- 7 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="6dp">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/icon_circle_bg"
                            android:padding="10dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/s_studymaterial"
                                android:tint="@color/maroon"
                                android:adjustViewBounds="true"
                                android:scaleType="centerInside"/>

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Materials"
                            android:textSize="11sp"
                            android:layout_marginTop="8dp"/>

                    </LinearLayout>

                    <!-- 8 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="6dp">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/icon_circle_bg"
                            android:padding="10dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/s_settings"
                                android:tint="@color/maroon"
                                android:adjustViewBounds="true"
                                android:scaleType="centerInside"/>

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Settings"
                            android:textSize="11sp"
                            android:layout_marginTop="8dp"/>

                    </LinearLayout>

                </GridLayout>

                <!-- bottom spacing -->
                <!-- <View android:layout_width="match_parent" android:layout_height="32dp"/>-->
            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>
