<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Material Toolbar (No padding) -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/Lavender"
        app:title="Join New Classroom"
        app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6"
        app:subtitle="Enter details shared by your teacher"
        app:subtitleTextAppearance="@style/TextAppearance.MaterialComponents.Body2"
        app:titleTextColor="@color/white"
        app:subtitleTextColor="@color/white"
        app:navigationIconTint="@color/white"
        app:navigationIcon="@drawable/s_arrowback"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Enter Class ID to Enroll"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/topAppBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- EditText for Class ID -->
    <EditText
        android:id="@+id/etClassId"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Class ID e.g. CL1001"
        android:padding="12dp"
        android:background="@drawable/s_edittext_border"
        android:inputType="text"
        android:textColor="@color/black"
        android:textColorHint="@color/light_greay"
        android:textSize="18dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Enroll Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSubmitEnroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Enroll"
        android:textColor="@color/black"
        android:background="@drawable/s_btn_bg_shape"
        android:textSize="16dp"
        android:layout_marginTop="18dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/etClassId"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Status TextView -->
    <TextView
        android:id="@+id/tvEnrollStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#d32f2f"
        android:textSize="16sp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnSubmitEnroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>
