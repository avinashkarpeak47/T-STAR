<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/Lavender"
        app:title="Submit Assignment"
        app:subtitle="Share your completed work with teacher"
        app:titleTextColor="@color/white"
        app:subtitleTextColor="@color/white"
        app:navigationIcon="@drawable/s_arrowback"
        app:navigationIconTint="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardSubmission"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:layout_marginRight="22dp"
        android:layout_marginLeft="22dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="14dp"
        app:layout_constraintTop_toBottomOf="@id/topAppBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/s_edittext_border">

            <!-- Status -->
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/txtStatus"
                    android:text="Not Submitted"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#D32F2F"
                    android:textAllCaps="true" />

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:id="@+id/txtLateBadge"
                    android:text="   LATE"
                    android:visibility="gone"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_late_badge"
                    android:padding="6dp"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/txtDueDate"
                android:text="Due Date: "
                android:textSize="14sp"
                android:textColor="@color/black"
                android:layout_marginTop="6dp"/>



            <View
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:background="#A2A2A2"
                android:layout_marginVertical="12dp"/>

            <!-- File info -->
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <ImageView
                    android:id="@+id/imgFileType"
                    android:layout_width="34dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_file_generic"/>

                <TextView
                    android:id="@+id/txtFileName"
                    android:text="No file selected"
                    android:layout_marginStart="12dp"
                    android:textSize="14sp"
                    android:maxLines="2"
                    android:textColor="@color/black"
                    android:textStyle="italic"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnChooseFile"
                android:text="Choose File"
                android:textColor="@color/white"
                android:backgroundTint="@color/maroon"
                android:layout_marginTop="30dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnSubmitAssignment"
                android:text="Submit Assignment"
                android:textColor="@color/white"
                android:backgroundTint="@color/green"
                android:layout_marginTop="18dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnViewSubmission"
                android:text="View Submitted File"
                android:textColor="@color/white"
                android:backgroundTint="@color/orange"
                android:visibility="gone"
                android:layout_marginTop="18dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>