<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:id="@+id/entry_page_ll_id1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/finalist_loginpage_bg">


        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Login to\nyour account"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginTop="68dp"
            android:layout_marginLeft="31dp"/>



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:layout_marginTop="150dp">

            <!-- Email Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your email"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/et_login_email"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/s_edittext_border"
                android:paddingStart="14dp"
                android:hint="Enter your email"
                android:textColor="@color/black"
                android:textColorHint="#8A8A8A"
                android:layout_marginTop="6dp"
                android:inputType="textEmailAddress"/>

            <!-- Password Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Password"
                android:layout_marginTop="16dp"
                android:textColor="@color/black"
                android:textSize="16dp"/>

            <EditText
                android:id="@+id/et_login_password"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/s_edittext_border"
                android:paddingStart="14dp"
                android:hint="Enter your password"
                android:inputType="textPassword"
                android:textColor="#000000"
                android:textColorHint="#8A8A8A"
                android:layout_marginTop="6dp"
                android:drawableEnd="@drawable/baseline_visibility_24"
                android:paddingEnd="12dp"/>

            <!-- Forgot Password -->
            <TextView
                android:id="@+id/tv_login_forgot_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Forgot password?"
                android:textSize="14sp"
                android:textColor="#4A55FF"
                android:layout_marginTop="6dp"
                android:layout_gravity="end"/>



            <!-- Login Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_login"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Log in"
                android:textAllCaps="false"
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:background="@drawable/s_btn_bg_shape"
                android:layout_marginTop="26dp"/>

            <!-- Social Icons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginTop="9.5dp"
                android:weightSum="2"
                android:padding="4dp">


                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_login_with_mobile"
                    android:text="Login with Mobile"
                    android:textColor="@color/black"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:background="@drawable/s_btn_bg_shape"
                    android:textAllCaps="false"
                    android:layout_weight="1"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_guest_login"
                    android:text="Guest Login"
                    android:textColor="@color/black"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="20dp"
                    android:background="@drawable/s_btn_bg_shape"
                    android:textAllCaps="false"
                    android:layout_weight="1" />

            </LinearLayout>
            <!-- Register Text -->
            <TextView
                android:id="@+id/tv_register"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Don’t have an account? Register!"
                android:textSize="13sp"
                android:textColor="@color/black"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"/>

        </LinearLayout>






    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>


