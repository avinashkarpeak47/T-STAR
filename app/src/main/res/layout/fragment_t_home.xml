<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    tools:context=".TEACHERACTIVITIES.TFragment.THomeFragment">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@drawable/header_gradient"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:title="Welcome"
        app:titleTextColor="@color/white"
        app:titleCentered="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgProfile"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/tprofile"
            android:layout_gravity="end|center_vertical"
            app:tint="@color/white"/>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp">

            <!-- Grid Layout -->
            <androidx.gridlayout.widget.GridLayout
                android:id="@+id/gridActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:columnCount="2"
                app:useDefaultMargins="true"
                app:alignmentMode="alignMargins">

                <!-- Assignment Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCreateAssignment"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    app:layout_columnWeight="1"
                    android:backgroundTint="@color/maroon_variant"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="6dp"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/tassignment"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Assignment"
                            android:textSize="15sp"
                            android:textColor="@color/white"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Attendance Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardAttendance"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    app:layout_columnWeight="1"
                    android:backgroundTint="@color/maroon_variant"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="6dp"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/tattendance"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Attendance"
                            android:textSize="15sp"
                            android:textColor="@color/white"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Event Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCreateEvent"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    app:layout_columnWeight="1"
                    android:backgroundTint="@color/maroon_variant"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="6dp"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/tevent"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Event"
                            android:textSize="15sp"
                            android:textColor="@color/white"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Chat with Student -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardChat"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    app:layout_columnWeight="1"
                    android:backgroundTint="@color/maroon_variant"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="6dp"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/tchatstudent"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chat with Student"
                            android:textSize="15sp"
                            android:textColor="@color/white"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Students Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardStudents"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    app:layout_columnWeight="1"
                    android:backgroundTint="@color/maroon_variant"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="6dp"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/tstudent"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Students"
                            android:textSize="15sp"
                            android:textColor="@color/white"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Resources Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardResources"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    app:layout_columnWeight="1"
                    android:backgroundTint="@color/maroon_variant"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="6dp"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/tresources"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resources"
                            android:textSize="15sp"
                            android:textColor="@color/white"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Notifications -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardNotifications"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    app:layout_columnSpan="2"
                    android:backgroundTint="@color/maroon_variant"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="6dp"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/tnotification"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Send Notification"
                            android:textSize="18sp"
                            android:textColor="@color/white"
                            android:layout_marginStart="16dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </androidx.gridlayout.widget.GridLayout>
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
