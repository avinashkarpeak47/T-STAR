<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    tools:context=".TEACHERACTIVITIES.TAssignDetailActivity">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@drawable/header_gradient"
        app:navigationIcon="@drawable/arrow_back"
        app:title="Assignment Details"
        app:titleTextColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- SCROLL VIEW -->
    <ScrollView
        android:id="@+id/topScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@+id/rvStudentStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/maroon_variant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- TITLE -->
                <TextView
                    android:id="@+id/tvTitleDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Assignment Title"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- DUE DATE -->
                <TextView
                    android:id="@+id/tvDueDateDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Due: 20-02-2025"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:alpha="0.85"/>

                <!-- DESCRIPTION -->
                <TextView
                    android:id="@+id/tvDescDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:padding="12dp"
                    android:background="#FFFFFF"
                    android:text="Full description goes here..."
                    android:textColor="@color/black"
                    android:textSize="15sp"/>

                <!-- ATTACHMENT TITLE -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Attachments"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:textSize="18sp" />

                <!-- FIRST ROW (Icon + name) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/btnViewAttachment"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/t_attachment"
                        app:tint="@color/white"/>

                    <TextView
                        android:id="@+id/tvAttachmentName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="No file attached"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:alpha="0.85"/>
                </LinearLayout>

                <!-- ⭐ REQUIRED: MULTIPLE ATTACHMENTS CONTAINER -->
                <LinearLayout
                    android:id="@+id/attachmentContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp">
                </LinearLayout>

                <!-- SUBMISSION TITLE -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Submission Status"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:textSize="20sp" />

                <!-- Total Students -->
                <TextView
                    android:id="@+id/tvTotalStudents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total Students: 40"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginTop="10dp"/>

                <!-- Submitted -->
                <TextView
                    android:id="@+id/tvSubmitted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Submitted: 30"
                    android:textColor="#00FF7F"
                    android:textSize="14sp"
                    android:layout_marginTop="10dp"/>

                <!-- Unsubmitted -->
                <TextView
                    android:id="@+id/tvUnsubmitted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Unsubmitted: 10"
                    android:textColor="#FF6347"
                    android:textSize="14sp"
                    android:layout_marginTop="10dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </ScrollView>

    <!-- STUDENT LIST -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvStudentStatus"
        android:layout_width="417dp"
        android:layout_height="254dp"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topScroll" />
</androidx.constraintlayout.widget.ConstraintLayout>
